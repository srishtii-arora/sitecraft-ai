{
  "name": "sitecraft-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": { "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"", "dev:server": "node --env-file-if-exists=.env --import tsx --watch server/index.ts", "dev:client": "vite --configLoader runner --force --host 0.0.0.0", "build": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.server.json && vite build --configLoader runner", "start": "node --env-file-if-exists=.env dist-server/index.js", "preview": "vite preview --configLoader runner", "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json" },
  "dependencies": { "cors": "^2.8.5", "express": "^4.21.2", "lucide-react": "^0.468.0", "playwright": "^1.51.0", "react": "^18.3.1", "react-dom": "^18.3.1", "zod": "^3.24.2" },
  "devDependencies": { "@types/cors": "^2.8.17", "@types/express": "^5.0.0", "@types/node": "^22.13.4", "@types/react": "^18.3.18", "@types/react-dom": "^18.3.5", "@vitejs/plugin-react": "^4.3.4", "concurrently": "^9.1.2", "tsx": "^4.19.3", "typescript": "~5.7.2", "vite": "^6.1.0" }
}
